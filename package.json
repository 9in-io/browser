  "keywords": [
    "9in",
    "sso",
    "oauth2",
    "openid-connect",
    "oidc",
    "pkce",
    "browser",
    "cdn"
  ],
  "license": "MIT",
  "author": "9in <support@9in.io>",
  "homepage": "https://9in.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/9in-io/browser.git"
  },
  "main": "dist/9in.umd.min.js",
  "unpkg": "dist/9in.min.js",
  "jsdelivr": "dist/9in.min.js",
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "webpack",
    "test": "npm run build && jest --verbose"
  },
  "devDependencies": {
    "@9in-io/sdk": "^0.1.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "~5.9.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}

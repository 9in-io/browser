{
    "include": ["src"],
    "exclude": ["src/__test__", "dist", "html"],
    "compilerOptions": {
        "target": "es2020",
        "lib": ["es2023", "dom"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": false
    }
}
